{
  "name": "dtm-synth",
  "version": "2.0.0",
  "private": true,
  "description": "完全無料のバーチャルアナログ・シンセサイザー / DTM ワークステーション（Web / Windows対応）",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "electron:dev": "vite build && electron electron/main.cjs",
    "electron:build": "vite build && electron-builder --win portable",
    "piano:dev": "vite --open /piano/",
    "piano:icons": "node scripts/gen-piano-icons.mjs",
    "piano:electron": "vite build && electron electron/piano-main.cjs",
    "piano:build:win": "vite build && electron-builder --win portable --config electron-builder.piano.json",
    "test:audio": "node scripts/audio-smoke.mjs",
    "test": "tsc --noEmit && vite build && node scripts/audio-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "optionalDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.microsakurastudio.app",
    "productName": "Micro Sakura Studio",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}
